<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Admin | Abbayouth Christmas</title><link rel="stylesheet" href="/styles.css"></head>
<body class="admin-body"><div id="loginView" class="login-card">
  <div class="brand"><div class="brand-mark">✦</div><div class="eyebrow">Administrator</div><h1>Abbayouth Christmas</h1><p>Hope Found Me · Masuk untuk mengelola registrasi pengunjung.</p></div>
  <form id="loginForm"><div class="field"><label>Username</label><input name="username" required autocomplete="username"></div><div class="field"><label>Password</label><input name="password" type="password" required autocomplete="current-password"></div><div id="loginError" class="alert"></div><button class="btn btn-primary">LOGIN</button></form>
</div>
<main id="dashboardView" class="admin-wrap hidden">
  <header class="admin-header"><div><div class="eyebrow">Hope Found Me · Event Management</div><h1>Abbayouth Christmas</h1><p>Selamat datang, <span id="adminName">Admin</span>. Berikut ringkasan registrasi pengunjung.</p></div><div style="display:flex;gap:9px;flex-wrap:wrap"><button class="btn-outline" id="qrBtn">QR REGISTRASI</button><button class="btn-outline" id="refreshBtn">REFRESH</button><button class="btn-dark" id="exportBtn">DOWNLOAD EXCEL ↓</button><button class="btn-outline" id="logoutBtn">LOGOUT</button></div></header>
  <section class="stats">
    <div class="stat"><span>Total Registered Guests</span><strong id="registered">0</strong></div>
    <div class="stat"><span>Available Lottery Numbers</span><strong id="available">500</strong></div>
    <div class="stat"><span>Used Lottery Numbers</span><strong id="used">0</strong></div>
    <div class="stat"><span>Registration Progress</span><strong id="progressText">0%</strong><div class="progress"><div id="progressBar"></div></div></div>
  </section>
  <section class="data-card" style="margin-bottom:18px">
    <div class="data-top"><h2>Pengaturan Lottery Ticket</h2><span class="muted">Hanya administrator</span></div>
    <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:end;margin:12px 0">
      <div class="field"><label for="ticketCapacity">Total Lottery Ticket (1–100.000)</label><input id="ticketCapacity" type="number" min="1" max="100000" step="1" required style="max-width:220px"></div>
      <button class="btn-dark" id="saveCapacityBtn" type="button">SIMPAN JUMLAH TIKET</button>
    </div>
    <p class="muted">Mengurangi kapasitas tidak diperbolehkan jika nomor di atas batas baru masih digunakan.</p>
    <div style="border-top:1px solid #ddd;padding-top:16px;margin-top:16px">
      <button class="btn-delete" id="resetLotteryBtn" type="button">RESET LOTTERY &amp; REGISTRASI</button>
      <p class="muted">Peringatan: reset akan menghapus SELURUH data registrasi dan mengembalikan semua tiket menjadi tersedia. Unduh Excel dan backup database dahulu.</p>
    </div>
    <div id="lotterySettingsMessage" class="admin-notice hidden" role="status" aria-live="polite"></div>
  </section>
  <section class="data-card"><div class="data-top"><h2>Guest Registration Data</h2><span class="muted" id="totalLabel">0 data</span></div>
    <div class="toolbar"><input id="search" placeholder="Cari nama, handphone, undian..."><input type="date" id="from"><input type="date" id="to"><select id="sort"><option value="registeredAt">Waktu registrasi</option><option value="fullName">Nama</option><option value="lotteryNumber">Nomor undian</option></select><select id="direction"><option value="desc">Terbaru / Z–A</option><option value="asc">Terlama / A–Z</option></select><button class="btn-outline" id="filterBtn">FILTER</button></div>
    <div class="table-wrap"><table><thead><tr><th>No.</th><th>Nomor Undian</th><th>Nama</th><th>No. Handphone</th><th>Alamat</th><th>Nama Pemurid</th><th>Gereja Asal</th><th>Sumber Informasi</th><th>Waktu Registrasi (WIB)</th><th>Aksi</th></tr></thead><tbody id="guestRows"><tr><td colspan="9">Memuat data...</td></tr></tbody></table></div>
    <div class="pagination"><span id="pageInfo">Halaman 1</span><div style="display:flex;gap:8px"><button class="btn-outline" id="prevBtn">← Sebelumnya</button><button class="btn-outline" id="nextBtn">Selanjutnya →</button></div></div>
  </section>
  <div id="deleteMessage" role="status" aria-live="polite" class="admin-notice hidden"></div>
  <div id="qrModal" class="login-card hidden" style="position:fixed;z-index:5;inset:50% auto auto 50%;transform:translate(-50%,-50%);width:min(92vw,380px);text-align:center"><h2>QR Code Registrasi</h2><p class="muted">Scan untuk membuka halaman registrasi.</p><img id="qrImage" alt="QR registrasi" style="width:250px;max-width:100%"><p><button class="btn-outline" id="closeQr">TUTUP</button></p></div>
</main><script src="/admin.js"></script></body></html>
